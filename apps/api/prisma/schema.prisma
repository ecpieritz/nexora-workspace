generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")

  @@map("workspace_role")
}

enum CustomerGender {
  MALE       @map("male")
  FEMALE     @map("female")
  NON_BINARY @map("non-binary")

  @@map("customer_gender")
}

enum InvoiceStatus {
  COMPLETE  @map("complete")
  PENDING   @map("pending")
  CANCELLED @map("cancelled")

  @@map("invoice_status")
}

enum ScheduleKind {
  EVENT    @map("event")
  REMINDER @map("reminder")
  TASK     @map("task")

  @@map("schedule_kind")
}

enum TaskCategory {
  DESIGN      @map("design")
  DEVELOPMENT @map("development")
  RESEARCH    @map("research")

  @@map("task_category")
}

enum TaskStatus {
  TODO  @map("todo")
  DOING @map("doing")
  DONE  @map("done")

  @@map("task_status")
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique @db.VarChar(320)
  username              String    @unique @db.VarChar(50)
  passwordHash          String    @map("password_hash") @db.VarChar(255)
  fullName              String    @map("full_name") @db.VarChar(120)
  displayName           String?   @map("display_name") @db.VarChar(80)
  phone                 String?   @db.VarChar(30)
  birthDate             DateTime? @map("birth_date") @db.Date
  bio                   String?   @db.VarChar(500)
  taxId                 String?   @unique @map("tax_id") @db.VarChar(20)
  avatarUrl             String?   @map("avatar_url") @db.VarChar(2048)
  language              String    @default("en") @db.VarChar(10)
  timezone              String    @default("UTC") @db.VarChar(80)
  dateFormat            String    @default("MM/dd/yyyy") @map("date_format") @db.VarChar(30)
  currency              String    @default("USD") @db.Char(3)
  compactSidebar        Boolean   @default(false) @map("compact_sidebar")
  taskNotifications     Boolean   @default(true) @map("task_notifications")
  invoiceNotifications  Boolean   @default(true) @map("invoice_notifications")
  eventNotifications    Boolean   @default(true) @map("event_notifications")
  customerNotifications Boolean   @default(true) @map("customer_notifications")
  emailVerifiedAt       DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownedWorkspaces     Workspace[]          @relation("WorkspaceOwner")
  memberships         WorkspaceMember[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  customersCreated    Customer[]           @relation("CustomerCreatedBy")
  productsCreated     Product[]            @relation("ProductCreatedBy")
  invoicesCreated     Invoice[]            @relation("InvoiceCreatedBy")
  tasksCreated        WorkspaceTask[]      @relation("TaskCreatedBy")
  schedulesOrganized  ScheduleEntry[]      @relation("ScheduleOrganizer")

  @@map("users")
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  userAgent String?   @map("user_agent") @db.VarChar(500)
  ipAddress String?   @map("ip_address") @db.Inet
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   WorkspaceMember[]
  customers Customer[]
  products  Product[]
  invoices  Invoice[]
  tasks     WorkspaceTask[]
  schedules ScheduleEntry[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz(3)

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskAssignments    TaskAssignee[]
  scheduleAttendance ScheduleAttendee[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  workspaceId  String         @map("workspace_id") @db.Uuid
  createdById  String         @map("created_by_id") @db.Uuid
  firstName    String         @map("first_name") @db.VarChar(80)
  lastName     String         @map("last_name") @db.VarChar(80)
  email        String         @db.VarChar(320)
  phone        String         @db.VarChar(30)
  gender       CustomerGender
  role         String         @db.VarChar(100)
  address      String         @db.VarChar(300)
  performance  Int[]          @default([])
  satisfaction Int            @default(0)
  retention    Int            @default(0)
  color        String         @default("#625df5") @db.VarChar(7)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  invoices  Invoice[]

  @@unique([workspaceId, email])
  @@index([workspaceId, lastName, firstName])
  @@index([createdById])
  @@map("customers")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  sku         String?  @db.VarChar(80)
  name        String   @db.VarChar(160)
  brand       String   @db.VarChar(100)
  category    String   @db.VarChar(100)
  description String?  @db.VarChar(1000)
  price       Decimal  @db.Decimal(12, 2)
  negotiable  Boolean  @default(false)
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  invoiceItems InvoiceItem[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, name])
  @@index([createdById])
  @@map("products")
}

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  createdById  String        @map("created_by_id") @db.Uuid
  customerId   String?       @map("customer_id") @db.Uuid
  number       String        @db.VarChar(40)
  customerName String        @map("customer_name") @db.VarChar(160)
  email        String        @db.VarChar(320)
  address      String?       @db.VarChar(300)
  issuedAt     DateTime      @map("issued_at") @db.Timestamptz(3)
  dueAt        DateTime?     @map("due_at") @db.Timestamptz(3)
  status       InvoiceStatus @default(PENDING)
  favorite     Boolean       @default(false)
  currency     String        @default("USD") @db.Char(3)
  discount     Decimal       @default(0) @db.Decimal(5, 2)
  subtotal     Decimal       @default(0) @db.Decimal(14, 2)
  total        Decimal       @default(0) @db.Decimal(14, 2)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  customer  Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     InvoiceItem[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status, issuedAt])
  @@index([createdById])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  description String  @db.VarChar(300)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  amount      Decimal @db.Decimal(14, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model WorkspaceTask {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  createdById String       @map("created_by_id") @db.Uuid
  name        String       @db.VarChar(160)
  description String?      @db.VarChar(1000)
  category    TaskCategory
  startsAt    DateTime     @map("starts_at") @db.Timestamptz(3)
  dueAt       DateTime     @map("due_at") @db.Timestamptz(3)
  status      TaskStatus   @default(TODO)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User           @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignees TaskAssignee[]

  @@index([workspaceId, status, dueAt])
  @@index([createdById])
  @@map("tasks")
}

model TaskAssignee {
  taskId   String @map("task_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid

  task   WorkspaceTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([taskId, memberId])
  @@index([memberId])
  @@map("task_assignees")
}

model ScheduleEntry {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  organizerId String       @map("organizer_id") @db.Uuid
  title       String       @db.VarChar(160)
  description String?      @db.VarChar(1000)
  location    String?      @db.VarChar(200)
  kind        ScheduleKind @default(EVENT)
  startsAt    DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime?    @map("ends_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organizer User               @relation("ScheduleOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  attendees ScheduleAttendee[]

  @@index([workspaceId, startsAt])
  @@index([organizerId])
  @@map("schedule_entries")
}

model ScheduleAttendee {
  scheduleId String @map("schedule_id") @db.Uuid
  memberId   String @map("member_id") @db.Uuid

  schedule ScheduleEntry   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  member   WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([scheduleId, memberId])
  @@index([memberId])
  @@map("schedule_attendees")
}
