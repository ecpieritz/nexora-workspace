NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api
JSON_BODY_LIMIT=1mb
CORS_ORIGINS=http://localhost:4200,https://dev-nexora-workspace-delta.vercel.app,https://nexora-workspace-delta.vercel.app
DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora
TEST_DATABASE_URL=postgresql://nexora:nexora@localhost:5433/nexora_test
DATABASE_CONNECTION_TIMEOUT_MS=5000
PASSWORD_HASH_ROUNDS=12
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=nexora-api
JWT_AUDIENCE=nexora-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL=http://localhost:4200/auth/reset-password
