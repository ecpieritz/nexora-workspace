# Copy to .env.production and replace every placeholder before starting production.
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://nexora:replace-with-a-url-encoded-password@postgres:5432/nexora

WEB_PORT=8080
CORS_ORIGINS=https://nexora.example.com
PASSWORD_RESET_URL=https://nexora.example.com/auth/reset-password

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=nexora-api
JWT_AUDIENCE=nexora-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30

JSON_BODY_LIMIT=1mb
DATABASE_CONNECTION_TIMEOUT_MS=5000
PASSWORD_HASH_ROUNDS=12
