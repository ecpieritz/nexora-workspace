{
  "name": "nexora-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "ng": "npm run ng --workspace=@nexora/web --",
    "start": "npm run start --workspace=@nexora/web",
    "dev:web": "npm run start --workspace=@nexora/web",
    "dev:api": "npm run dev --workspace=@nexora/api",
    "start:api": "npm run start --workspace=@nexora/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:status": "docker compose ps",
    "db:generate": "npm run prisma:generate --workspace=@nexora/api",
    "db:validate": "npm run prisma:validate --workspace=@nexora/api",
    "db:seed": "npm run prisma:seed --workspace=@nexora/api",
    "db:studio": "npm run prisma:studio --workspace=@nexora/api",
    "db:migrate": "npm run prisma:migrate --workspace=@nexora/api",
    "db:deploy": "npm run prisma:migrate:deploy --workspace=@nexora/api",
    "build": "npm run build --workspaces --if-present",
    "watch": "npm run watch --workspace=@nexora/web",
    "test": "npm run test --workspace=@nexora/web",
    "test:ci": "npm run test:ci --workspace=@nexora/web",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run lint && npm run db:validate && npm run test:ci && npm run build"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
