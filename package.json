{
  "name": "nexora-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ng": "npm run ng --workspace=@nexora/web --",
    "start": "npm run start --workspace=@nexora/web",
    "build": "npm run build --workspace=@nexora/web",
    "watch": "npm run watch --workspace=@nexora/web",
    "test": "npm run test --workspace=@nexora/web",
    "test:ci": "npm run test:ci --workspace=@nexora/web",
    "lint": "npm run lint --workspace=@nexora/web",
    "lint:fix": "npm run lint:fix --workspace=@nexora/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run lint && npm run test:ci && npm run build"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
